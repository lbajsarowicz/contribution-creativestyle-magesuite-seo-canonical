{
    "name": "creativestyle/magesuite-seo-canonical",
    "license": ["OSL-3.0", "AFL-3.0"],
    "type": "magento2-module",
    "require": {
        "magento/module-catalog": ">=104.0.8",
        "creativestyle/magesuite-opengraph": ">=1.4.0"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "MageSuite\\SeoCanonical\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
